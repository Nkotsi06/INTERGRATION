# ============================================================
# server/.env.example
# Copy to server/.env for local development.
# On Render, set these in Dashboard → Environment instead.
# ============================================================

# --- Runtime ---
# PORT: DO NOT SET THIS ON RENDER. Render provides PORT automatically.
#       For local development, 5000 is fine.
PORT=5000
NODE_ENV=development

# --- Database (Neon PostgreSQL) ---
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL=true

# --- Authentication ---
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT secret for local and production.
JWT_SECRET=replace_me_with_a_96_char_hex_string
JWT_EXPIRY=8h
BCRYPT_ROUNDS=10
SESSION_TIMEOUT_MINUTES=30

# --- File Upload ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_FORMATS=pdf,jpg,jpeg,png
FILE_STORAGE_TYPE=local

# --- Biometrics ---
BIOMETRIC_FINGERPRINT_ENABLED=true
BIOMETRIC_FACIAL_ENABLED=true
BIOMETRIC_MATCH_THRESHOLD=85
BIOMETRIC_MAX_ATTEMPTS=3

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# NO trailing slashes. Browsers send origins without them, so a
# trailing slash causes the exact-match comparison to fail.
#   Local:      http://localhost:5173
#   Production: https://intergration-one.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173