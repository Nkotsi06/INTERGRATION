{
  "name": "integrated-government-services",
  "version": "1.0.0",
  "description": "Integrated Government Services System for Lesotho - Monorepo",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "start:client": "cd client && npm run preview",
    "start:server": "cd server && npm start",
    "db:setup": "psql -U postgres -d integrated_gov_services -f server/src/database/schema.sql",
    "admin:hash": "cd server && node scripts/generate-admin-hash.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}