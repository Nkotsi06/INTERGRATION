# ============================================================
# client/.env.example
# Copy to client/.env for local development.
# On Vercel, set VITE_API_BASE_URL in Dashboard → Settings →
# Environment Variables, then REDEPLOY (Vite bakes VITE_*
# values into the bundle at build time).
# ============================================================

# Base URL of the backend API. MUST end with /api.
#   Local:      http://localhost:5000/api
#   Production: https://intergration-nhhf.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Default language code (must match a row in the languages table).
VITE_DEFAULT_LANGUAGE=EN

# Feature flags — must be the literal strings "true" or "false".
VITE_ENABLE_BIOMETRICS=true
VITE_ENABLE_OFFLINE_INDICATOR=false