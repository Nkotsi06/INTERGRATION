# ============================================================
# ROOT .gitignore — Integrated Government Services System
# ============================================================

# -----------------------------
# Dependencies
# -----------------------------
node_modules/
**/node_modules/
jspm_packages/

# -----------------------------
# Environment Variables
# -----------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# -----------------------------
# Build Output
# -----------------------------
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
**/dist/
**/build/
**/out/

# -----------------------------
# Logs
# -----------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/logs/
**/*.log

# -----------------------------
# Runtime Data
# -----------------------------
pids/
*.pid
*.seed
*.pid.lock

# -----------------------------
# Coverage / Test
# -----------------------------
coverage/
.nyc_output/
*.lcov
lib-cov
.jest-cache/

# -----------------------------
# Uploads (user-uploaded files)
# -----------------------------
server/uploads/*
!server/uploads/.gitkeep
server/uploads/documents/*
!server/uploads/documents/.gitkeep
server/uploads/signatures/*
!server/uploads/signatures/.gitkeep
server/uploads/biometrics/*
!server/uploads/biometrics/.gitkeep
server/uploads/photos/*
!server/uploads/photos/.gitkeep
server/uploads/logos/*
!server/uploads/logos/.gitkeep

# -----------------------------
# Temporary Files
# -----------------------------
.tmp/
.temp/
.tmp.*
*.tmp
*.temp
.cache/
.parcel-cache/
.vite/
**/.cache/
**/.vite/

# -----------------------------
# OS Files
# -----------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------
# IDE / Editor Files
# -----------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# -----------------------------
# Database
# -----------------------------
*.sql.gz
*.dump
*.sql.bak
!server/src/database/schema.sql

# -----------------------------
# Node / Package Manager
# -----------------------------
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*
.pnp.js

# -----------------------------
# TypeScript
# -----------------------------
*.tsbuildinfo
**/*.tsbuildinfo

# -----------------------------
# Misc
# -----------------------------
.eslintcache
.stylelintcache
.node_repl_history
.vercel
.netlify
.firebase/